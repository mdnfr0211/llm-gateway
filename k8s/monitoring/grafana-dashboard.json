{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["litellm"],
  "title": "LiteLLM",
  "uid": "litellm-overview",
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(rate(litellm_proxy_total_requests_metric_total[1m])) by (requested_model)",
          "legendFormat": "{{requested_model}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "fixedColor": "red", "mode": "fixed" }, "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(rate(litellm_proxy_failed_requests_metric_total[1m])) by (requested_model)",
          "legendFormat": "{{requested_model}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Input Tokens (tokens/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(rate(litellm_input_tokens_metric_total[1m])) by (model)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Output Tokens (tokens/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(rate(litellm_output_tokens_metric_total[1m])) by (model)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total Tokens (tokens/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(rate(litellm_total_tokens_metric_total[1m])) by (model)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Request Latency — p50 / p90 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(litellm_request_total_latency_metric_bucket[1m])) by (le, model))",
          "legendFormat": "p50 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(litellm_request_total_latency_metric_bucket[1m])) by (le, model))",
          "legendFormat": "p90 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(litellm_request_total_latency_metric_bucket[1m])) by (le, model))",
          "legendFormat": "p95 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(litellm_request_total_latency_metric_bucket[1m])) by (le, model))",
          "legendFormat": "p99 {{model}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "LLM API Latency — p50 / p90 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(litellm_llm_api_latency_metric_bucket[1m])) by (le, model))",
          "legendFormat": "p50 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(litellm_llm_api_latency_metric_bucket[1m])) by (le, model))",
          "legendFormat": "p90 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(litellm_llm_api_latency_metric_bucket[1m])) by (le, model))",
          "legendFormat": "p95 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(litellm_llm_api_latency_metric_bucket[1m])) by (le, model))",
          "legendFormat": "p99 {{model}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Overhead Latency — p50 / p90 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(litellm_overhead_latency_metric_bucket[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(litellm_overhead_latency_metric_bucket[1m])) by (le))",
          "legendFormat": "p90"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(litellm_overhead_latency_metric_bucket[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(litellm_overhead_latency_metric_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 9,
      "title": "Time to First Token — p50 / p90 / p95 / p99 (streaming)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(litellm_llm_api_time_to_first_token_metric_bucket[1m])) by (le, model))",
          "legendFormat": "p50 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(litellm_llm_api_time_to_first_token_metric_bucket[1m])) by (le, model))",
          "legendFormat": "p90 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(litellm_llm_api_time_to_first_token_metric_bucket[1m])) by (le, model))",
          "legendFormat": "p95 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(litellm_llm_api_time_to_first_token_metric_bucket[1m])) by (le, model))",
          "legendFormat": "p99 {{model}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Deployment Success vs Failure",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(rate(litellm_deployment_success_responses_total[1m])) by (litellm_model_name)",
          "legendFormat": "success {{litellm_model_name}}"
        },
        {
          "expr": "sum(rate(litellm_deployment_failure_responses_total[1m])) by (litellm_model_name)",
          "legendFormat": "failure {{litellm_model_name}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "In-Flight Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(litellm_in_flight_requests)",
          "legendFormat": "in-flight"
        }
      ]
    },
    {
      "id": 12,
      "title": "Input Tokens by Model (total in time range)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "valueMode": "color"
      },
      "targets": [
        {
          "expr": "sum(increase(litellm_input_tokens_metric_total[$__range])) by (requested_model)",
          "legendFormat": "{{requested_model}}",
          "instant": true
        }
      ]
    },
    {
      "id": 13,
      "title": "Output Tokens by Model (total in time range)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "valueMode": "color"
      },
      "targets": [
        {
          "expr": "sum(increase(litellm_output_tokens_metric_total[$__range])) by (requested_model)",
          "legendFormat": "{{requested_model}}",
          "instant": true
        }
      ]
    }
  ]
}
